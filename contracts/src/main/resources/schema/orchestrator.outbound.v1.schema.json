{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://podorc.dev/schema/orchestrator.outbound.v1.schema.json",
  "title": "orchestrator.outbound message (v1)",
  "description": "Contract for messages on the orchestrator.outbound Kafka topic. Mirrors com.podorc.contracts.message.OutboundMessage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "correlation_id",
    "type",
    "payload",
    "timestamp"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid",
      "description": "Copied from the message that triggered this one."
    },
    "type": {
      "type": "string",
      "enum": [
        "status_update",
        "result",
        "sprint_created",
        "question_to_user",
        "task_failed"
      ]
    },
    "sprint_id": {
      "type": ["string", "null"]
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "agent_id": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object",
      "description": "Type-specific body; shape depends on \"type\". Empty object when there is nothing to carry."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
