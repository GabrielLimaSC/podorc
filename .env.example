# podorc — local environment template.
# Copy to `.env` and fill the values. `.env` is git-ignored; never commit real values.
# Keys are grouped by the sprint that introduces them.

# --- S1-01 · HTTP ---
PODORC_HTTP_PORT=
# Set to "always" only for local debugging; never in shared environments.
PODORC_HEALTH_SHOW_DETAILS=

# --- S1-02 · Postgres (names finalised by S1-02) ---
PODORC_DB_URL=
PODORC_DB_USERNAME=
PODORC_DB_PASSWORD=

# --- S1-02 · Kafka (names finalised by S1-02) ---
PODORC_KAFKA_BOOTSTRAP_SERVERS=

# --- S1-05 · LLM providers ---
# Decision 2: no API key. Adapters shell out to the Gabriel's logged-in CLIs
# (`claude -p --output-format json`, `codex exec`). Only paths/limits live here.
PODORC_LLM_CLAUDE_CLI_PATH=
PODORC_LLM_CODEX_CLI_PATH=
PODORC_LLM_MAX_COST_PER_TASK_USD=
PODORC_LLM_MAX_MONTHLY_COST_USD=
