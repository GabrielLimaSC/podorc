# podorc — local environment template.
# Copy to `.env` and fill the values. `.env` is git-ignored; never commit real values.

# --- HTTP ---
PODORC_HTTP_PORT=
# Set to "always" only for local debugging; never in shared environments.
PODORC_HEALTH_SHOW_DETAILS=

# --- Postgres ---
PODORC_DB_URL=
PODORC_DB_USERNAME=
PODORC_DB_PASSWORD=

# --- Kafka ---
PODORC_KAFKA_BOOTSTRAP_SERVERS=

# --- LLM providers ---
# No API key: adapters shell out to the operator's logged-in CLIs
# (`claude -p --output-format json`, `codex exec`). No USD ceiling in v1 —
# per-task cost stays a documented `agent.yaml` field (accepted, not enforced), and the real
# control is each CLI's 5h/weekly subscription window.
# Blank means: resolve the executable on PATH, and use the built-in defaults.
PODORC_LLM_CLAUDE_CLI_PATH=
PODORC_LLM_CODEX_CLI_PATH=
# ISO-8601 duration; default 180s.
PODORC_LLM_TIMEOUT=
# Passed to `claude --disallowedTools`; default "*" (block every tool).
PODORC_LLM_DISALLOWED_TOOLS=
