# podorc — local environment template.
# Copy to `.env` and fill the values. `.env` is git-ignored; never commit real values.
# Keys are grouped by the sprint that introduces them.

# --- S1-01 · HTTP ---
PODORC_HTTP_PORT=
# Set to "always" only for local debugging; never in shared environments.
PODORC_HEALTH_SHOW_DETAILS=

# --- S1-02 · Postgres (names finalised by S1-02) ---
PODORC_DB_URL=
PODORC_DB_USERNAME=
PODORC_DB_PASSWORD=

# --- S1-02 · Kafka (names finalised by S1-02) ---
PODORC_KAFKA_BOOTSTRAP_SERVERS=

# --- S1-05 · LLM providers ---
# Decision 2: no API key. Adapters shell out to the operator's logged-in CLIs
# (`claude -p --output-format json`; `codex exec` arrives with S1-10). No USD ceiling in v1 —
# per-task cost stays a documented `agent.yaml` field (accepted, not enforced), and the real
# control is each CLI's 5h/weekly subscription window (S6).
# Blank means: resolve the executable on PATH, and use the built-in defaults.
PODORC_LLM_CLAUDE_CLI_PATH=
PODORC_LLM_CODEX_CLI_PATH=
# ISO-8601 duration; default 180s (Claude adapter).
PODORC_LLM_TIMEOUT=
# Passed to `claude --disallowedTools`; default "*" (block every tool).
PODORC_LLM_DISALLOWED_TOOLS=
# Codex adapter (S1-10). `codex exec` runs read-only in a neutral dir.
# ISO-8601 duration; default 180s.
PODORC_LLM_CODEX_TIMEOUT=
# `codex exec --sandbox` value; default "read-only".
PODORC_LLM_CODEX_SANDBOX=
# `-m` model. LEAVE BLANK for a Codex CLI on a ChatGPT subscription — it only accepts
# the account's default model and rejects an explicit -m with HTTP 400.
PODORC_LLM_CODEX_MODEL=
